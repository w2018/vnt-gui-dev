{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "VNT GUI 默认权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    "shell:allow-spawn",
    "shell:allow-kill",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "notification:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "core:event:default"
  ]
}
